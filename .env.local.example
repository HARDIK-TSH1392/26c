# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID is also exposed to the browser (Checkout.js needs it), the
# secret never leaves the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Razorpay webhook — Dashboard > Settings > Webhooks > Add New Webhook, URL:
# <your-url>/api/razorpay/webhook, events: payment.captured, payment.failed.
# Test and live mode each have their own separate webhook + secret.
RAZORPAY_WEBHOOK_SECRET=

# Cloud SQL Postgres — via Cloud SQL Auth Proxy for local dev:
# postgresql://USER:PASSWORD@localhost:5432/DBNAME
# On Cloud Run (Unix socket via --add-cloudsql-instances):
# postgresql://USER:PASSWORD@localhost/DBNAME?host=/cloudsql/CONNECTION_NAME
DATABASE_URL=

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3001

# Google OAuth — from Google Cloud Console > APIs & Services > Credentials
# Authorized redirect URI: <your-url>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — from https://resend.com/api-keys (for order confirmation + invoice emails)
RESEND_API_KEY=

# Admin dashboard session signing — generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=
