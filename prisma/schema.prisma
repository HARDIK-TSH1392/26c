generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------- NextAuth required models ----------
// https://authjs.dev/getting-started/adapters/prisma

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- App models ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  // collected via onboarding dialog after first Google login
  phone        String?
  isWhatsApp   Boolean  @default(false)
  dob          DateTime?
  onboarded    Boolean  @default(false)

  createdAt DateTime @default(now())

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String   @default("Home")
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

// status flow: created -> paid -> processing -> shipped -> delivered
//              (paid can also go straight to cancelled)
model Order {
  id        String   @id @default(cuid())
  userId    String?
  addressId String?

  guestName  String?
  guestEmail String?
  guestPhone String?

  shippingSnapshot String // JSON: {name, phone, address, city, state, pincode} at time of order

  subtotal Int // in rupees
  status   String @default("created")

  razorpayOrderId   String  @unique
  razorpayPaymentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items   OrderItem[]
  invoice Invoice?

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id          String @id @default(cuid())
  orderId     String
  productSlug String
  productName String
  colorway    String
  size        String
  qty         Int
  price       Int // rupees, per unit, at time of purchase

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String    @id @default(cuid())
  orderId       String    @unique
  invoiceNumber String    @unique
  pdfData       Bytes
  emailSentAt   DateTime?
  createdAt     DateTime  @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------- Admin (separate identity from customer Users on purpose) ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// Overlays dynamic stock availability onto the code-defined product catalog
// (data/products.ts). Missing row for a slug == in stock (default true).
model ProductStatus {
  slug      String   @id
  inStock   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}
